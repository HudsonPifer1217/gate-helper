{
  "manifest_version": 3,
  "name": "Gate Helper",
  "version": "0.3.0",
  "description": "One-click free downloads from Hypeddit and Droploud gates.",
  "permissions": [
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://hypeddit.com/*",
    "https://*.hypeddit.com/*",
    "https://droploud.com/*",
    "https://soundcloud.com/*",
    "https://www.instagram.com/*",
    "https://www.youtube.com/*",
    "https://www.dropbox.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "action": {
    "default_title": "Gate Helper settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://hypeddit.com/*",
        "https://*.hypeddit.com/*",
        "https://droploud.com/*"
      ],
      "js": [
        "content/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://hypeddit.com/*",
        "https://*.hypeddit.com/*"
      ],
      "js": [
        "content/common.js",
        "content/hypeddit.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://droploud.com/*"
      ],
      "js": [
        "content/common.js",
        "content/droploud.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://soundcloud.com/*",
        "https://www.instagram.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/popup-actions.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
